{
  "name": "@stepaway/server",
  "version": "0.4.1",
  "private": true,
  "description": "stepaway in-cluster HTTP backend (SPEC-v0.2 §1/§3): owns session lifecycle end to end, talks to the k8s API directly, no kubectl.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --target=bun --outfile=dist/server.js",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@stepaway/core": "workspace:*",
    "@types/bun": "^1.1.14"
  }
}
